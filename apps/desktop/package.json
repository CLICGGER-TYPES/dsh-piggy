{
  "name": "dsh-piggy-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "dsh-piggy \u684c\u9762\u7248\uff1aDSH \u4e4b\u5916\uff0c\u53cc\u51fb\u5c31\u6709\u4e00\u53ea\u732a",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "pack-game": "node scripts/pack-game.mjs",
    "start": "npm run pack-game && electron .",
    "dist:linux": "npm run pack-game && electron-builder --linux",
    "dist:win": "npm run pack-game && electron-builder --win",
    "dist:mac": "npm run pack-game && electron-builder --mac",
    "release-game": "node scripts/release-game.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.clicgger.dshpiggy",
    "productName": "dsh-piggy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "build/tray.png",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "dsh-piggy-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "dsh-piggy-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CLICGGER-TYPES",
        "repo": "dsh-piggy"
      }
    ],
    "portable": {
      "artifactName": "dsh-piggy-portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "dsh-piggy-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "piggy": {
    "minShell": "0.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.7.3"
  },
  "overrides": {
    "app-builder-lib": {
      "builder-util-runtime": "9.7.0"
    },
    "builder-util": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-builder": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-publish": {
      "builder-util-runtime": "9.7.0"
    },
    "electron-updater": {
      "builder-util-runtime": "9.7.0"
    }
  }
}
