; Optional extensions page for the full Windows installer (2026-10-27).
;
; Loaded through electron-builder 26.15.3 `nsis.include` (see electron-builder.optional.cjs).
; Hooks used (documented by the official templates we build against):
;   customInit              -> installer .onInit (templates/nsis/installer.nsi)
;   customPageAfterChangeDir-> after MUI_PAGE_DIRECTORY, before MUI_PAGE_INSTFILES
;                              (templates/nsis/assistedInstaller.nsh)
;   customInstall           -> after files/registry/shortcuts (templates/nsis/installSection.nsh)
;
; This file is ASCII only on purpose: every user-visible string comes from
; optional-extensions.generated.nsh, generated from strings.json (English field
; names) by apps/desktop/scripts/pack-optional-extensions.mjs. That keeps
; makensis source encoding out of the picture.
;
; Behaviour contract (docs/design/windows-optional-extensions-20261027.md):
; - five checkboxes, all unchecked by default, never restored from a previous
;   selection, never auto-selected in silent installs;
; - customInstall only writes $INSTDIR\resources\optional-extensions:
;   catalog.json + the selected .piggyext files + selection.json
;   {"version":1,"keys":[...]}; an empty selection writes an empty array;
; - no APPDATA / save data / user extension directory is touched, and old
;   optional-extensions payload from a previous install is replaced so the
;   selection file mtime is a fresh batch identity for the runtime importer;
; - farm-classic (same key, manual import variant) is never bundled here.

!ifndef OPTIONAL_EXTENSIONS_NSH
!define OPTIONAL_EXTENSIONS_NSH

!include "nsDialogs.nsh"
!include "LogicLib.nsh"

; Generated by scripts/pack-optional-extensions.mjs into build/ (an include dir).
!include "optional-extensions.generated.nsh"

!define OPTEXT_TARGET_DIR "$INSTDIR\resources\optional-extensions"
!define OPTEXT_SOURCE_DIR "${BUILD_RESOURCES_DIR}/optional-extensions"

Var /GLOBAL optExtDialog
Var /GLOBAL optExtCb0
Var /GLOBAL optExtCb1
Var /GLOBAL optExtCb2
Var /GLOBAL optExtCb3
Var /GLOBAL optExtCb4
Var /GLOBAL optExtSel0
Var /GLOBAL optExtSel1
Var /GLOBAL optExtSel2
Var /GLOBAL optExtSel3
Var /GLOBAL optExtSel4
Var /GLOBAL optExtKeys
Var /GLOBAL optExtFile

; Silent installs never run the page. Start from "nothing selected" so a silent
; install never picks up defaults or a previous batch.
!macro customInit
  StrCpy $optExtSel0 ""
  StrCpy $optExtSel1 ""
  StrCpy $optExtSel2 ""
  StrCpy $optExtSel3 ""
  StrCpy $optExtSel4 ""
!macroend

!macro customPageAfterChangeDir
  Page custom optExtPageCreate optExtPageLeave

  Function optExtPageCreate
    !insertmacro MUI_HEADER_TEXT "${OPTEXT_TITLE}" "${OPTEXT_SUBTITLE}"

    nsDialogs::Create 1018
    Pop $optExtDialog
    ${If} $optExtDialog == error
      Abort
    ${EndIf}

    ${NSD_CreateCheckbox} 0 0% 100% 8% "${OPTEXT_0_LABEL}"
    Pop $optExtCb0
    ${If} $optExtSel0 == "1"
      ${NSD_SetState} $optExtCb0 ${BST_CHECKED}
    ${EndIf}
    ${NSD_CreateLabel} 4% 8% 96% 8% "${OPTEXT_0_NOTE}"

    ${NSD_CreateCheckbox} 0 17% 100% 8% "${OPTEXT_1_LABEL}"
    Pop $optExtCb1
    ${If} $optExtSel1 == "1"
      ${NSD_SetState} $optExtCb1 ${BST_CHECKED}
    ${EndIf}
    ${NSD_CreateLabel} 4% 25% 96% 8% "${OPTEXT_1_NOTE}"

    ${NSD_CreateCheckbox} 0 34% 100% 8% "${OPTEXT_2_LABEL}"
    Pop $optExtCb2
    ${If} $optExtSel2 == "1"
      ${NSD_SetState} $optExtCb2 ${BST_CHECKED}
    ${EndIf}
    ${NSD_CreateLabel} 4% 42% 96% 8% "${OPTEXT_2_NOTE}"

    ${NSD_CreateCheckbox} 0 51% 100% 8% "${OPTEXT_3_LABEL}"
    Pop $optExtCb3
    ${If} $optExtSel3 == "1"
      ${NSD_SetState} $optExtCb3 ${BST_CHECKED}
    ${EndIf}
    ${NSD_CreateLabel} 4% 59% 96% 8% "${OPTEXT_3_NOTE}"

    ${NSD_CreateCheckbox} 0 68% 100% 8% "${OPTEXT_4_LABEL}"
    Pop $optExtCb4
    ${If} $optExtSel4 == "1"
      ${NSD_SetState} $optExtCb4 ${BST_CHECKED}
    ${EndIf}
    ${NSD_CreateLabel} 4% 76% 96% 8% "${OPTEXT_4_NOTE}"

    ; One reserved note row; restore only choices from this wizard visit.
    ${If} ${FileExists} "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
      ${NSD_CreateLabel} 0 84% 100% 8% "${OPTEXT_NOTE_UPDATE}"
    ${Else}
      ${NSD_CreateLabel} 0 84% 100% 8% "${OPTEXT_NOTE_KEEP}"
    ${EndIf}
    ${NSD_CreateLabel} 0 92% 100% 8% "${OPTEXT_NOTE_BUILTIN}"

    nsDialogs::Show
  FunctionEnd

  Function optExtPageLeave
    ${NSD_GetState} $optExtCb0 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $optExtSel0 "1"
    ${Else}
      StrCpy $optExtSel0 ""
    ${EndIf}

    ${NSD_GetState} $optExtCb1 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $optExtSel1 "1"
    ${Else}
      StrCpy $optExtSel1 ""
    ${EndIf}

    ${NSD_GetState} $optExtCb2 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $optExtSel2 "1"
    ${Else}
      StrCpy $optExtSel2 ""
    ${EndIf}

    ${NSD_GetState} $optExtCb3 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $optExtSel3 "1"
    ${Else}
      StrCpy $optExtSel3 ""
    ${EndIf}

    ${NSD_GetState} $optExtCb4 $0
    ${If} $0 == ${BST_CHECKED}
      StrCpy $optExtSel4 "1"
    ${Else}
      StrCpy $optExtSel4 ""
    ${EndIf}
  FunctionEnd
!macroend

!macro customInstall
  ; App resources only: replacing this folder never touches saves, APPDATA or
  ; the user's installed extensions.
  RMDir /r "${OPTEXT_TARGET_DIR}"
  CreateDirectory "${OPTEXT_TARGET_DIR}"
  SetOutPath "${OPTEXT_TARGET_DIR}"

  File "${OPTEXT_SOURCE_DIR}/catalog.json"

  ${If} $optExtSel0 == "1"
    File "${OPTEXT_SOURCE_DIR}/${OPTEXT_0_FILE}"
  ${EndIf}
  ${If} $optExtSel1 == "1"
    File "${OPTEXT_SOURCE_DIR}/${OPTEXT_1_FILE}"
  ${EndIf}
  ${If} $optExtSel2 == "1"
    File "${OPTEXT_SOURCE_DIR}/${OPTEXT_2_FILE}"
  ${EndIf}
  ${If} $optExtSel3 == "1"
    File "${OPTEXT_SOURCE_DIR}/${OPTEXT_3_FILE}"
  ${EndIf}
  ${If} $optExtSel4 == "1"
    File "${OPTEXT_SOURCE_DIR}/${OPTEXT_4_FILE}"
  ${EndIf}

  ; selection.json is rewritten on every install (also when nothing is picked),
  ; so its mtime is a new batch identity. The runtime importer treats an empty
  ; key list as "nothing to add" and never removes extensions by itself.
  StrCpy $optExtKeys ""
  ${If} $optExtSel0 == "1"
    StrCpy $optExtKeys '$optExtKeys,"${OPTEXT_0_KEY}"'
  ${EndIf}
  ${If} $optExtSel1 == "1"
    StrCpy $optExtKeys '$optExtKeys,"${OPTEXT_1_KEY}"'
  ${EndIf}
  ${If} $optExtSel2 == "1"
    StrCpy $optExtKeys '$optExtKeys,"${OPTEXT_2_KEY}"'
  ${EndIf}
  ${If} $optExtSel3 == "1"
    StrCpy $optExtKeys '$optExtKeys,"${OPTEXT_3_KEY}"'
  ${EndIf}
  ${If} $optExtSel4 == "1"
    StrCpy $optExtKeys '$optExtKeys,"${OPTEXT_4_KEY}"'
  ${EndIf}
  ${If} $optExtKeys != ""
    StrCpy $optExtKeys $optExtKeys "" 1
  ${EndIf}

  ClearErrors
  FileOpen $optExtFile "${OPTEXT_TARGET_DIR}\selection.json" w
  ${If} ${Errors}
    ${IfNot} ${Silent}
      MessageBox MB_ICONSTOP|MB_OK "optional-extensions: cannot write selection.json"
    ${EndIf}
    Abort
  ${EndIf}
  FileWrite $optExtFile '{"version":1,"keys":[$optExtKeys]}'
  FileWrite $optExtFile "$\r$\n"
  FileClose $optExtFile

  SetOutPath "$INSTDIR"
!macroend

!endif
